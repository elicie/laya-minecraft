[Unit]
Description=Laya Minecraft operations dashboard
After=network-online.target laya-minecraft-controller.service
Wants=laya-minecraft-controller.service

[Service]
Type=simple
WorkingDirectory=/home/elicie/Dev/laya-minecraft
Environment=PATH=/home/elicie/tools/node22/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/elicie/tools/node22/bin/node node_modules/vite/bin/vite.js --config apps/web/vite.config.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=default.target
