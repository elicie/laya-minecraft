MC_HOST=infra
MC_PORT=25565
MC_VERSION=26.1
MC_USERNAME=LayaBot
MC_AUTH=offline
OLLAYA_URL=http://127.0.0.1:8091
LAYA_MODEL=laya:multilingual
# Comma-separated allowed Minecraft player names. Empty permits local terminal only.
MC_OWNERS=

# Fine-tuned local model, raw commands (no keyword translation)
LAYA_ENDPOINT=http://127.0.0.1:8091/models/minecraft-ko-v1/api/decide
LAYA_POLICY_ENDPOINT=http://127.0.0.1:8091/models/minecraft-food-v1/api/decide
LAYA_ACTIVITY_ENDPOINT=http://127.0.0.1:8091/models/minecraft-activity-v1/api/decide
LAYA_NORMALIZE=0

# Optional isolated state and event directory (used by disposable live tests).
# BOT_LOG_DIR=/absolute/path/to/bot-state

# Fleet first-person cameras at /fleet on the web dashboard.
FLEET_VIEWER=1
FLEET_VIEWER_BASE_PORT=3100
FLEET_VIEW_DISTANCE=2
FLEET_LOG_DIR=logs/fleet/infra-25565
